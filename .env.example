# Required — get your key at openrouter.ai. Never put this in the HTML or GitHub.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary model and ordered fallbacks. Use API-compatible model slugs from openrouter.ai/models.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_NAME=Krishi.ai
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_TIMEOUT_SECONDS=25

# Optional — government mandi price API (data.gov.in). Leave blank to disable.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=

# Optional — CORS for a separately hosted frontend. Leave blank if Flask serves the HTML itself.
CORS_ORIGINS=

# Session storage — farmer profiles and conversation context are saved here.
# Default is ./data/sessions (created automatically). Free, no Redis needed.
KRISHI_SESSION_DIR=./data/sessions
# Sessions expire after 7 days of inactivity (in seconds).
SESSION_TTL_SECONDS=604800

# RAG / knowledge files
KRISHI_KNOWLEDGE_DIR=./knowledge
USE_CHROMA=false
KRISHI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma

# Server config
MAX_HISTORY_MESSAGES=10
MAX_REQUEST_BYTES=65536
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
