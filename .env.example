# ── LLM Providers (priority: Gemini → Groq → OpenRouter) ──
# At least one must be configured.

# Gemini — free tier, 1500 req/day (recommended primary)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=12

# Groq — free tier, very fast (secondary)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=12

# OpenRouter — last resort fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_NAME=Krishi.ai
OPENROUTER_TIMEOUT_SECONDS=12

# ── Live Data APIs (optional) ──
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=

# ── RAG / Knowledge Base ──
KRISHI_KNOWLEDGE_DIR=knowledge
KRISHI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_SCORE_THRESHOLD=0.25
RAG_TOP_K=5

# ── Storage ──
KRISHI_DATA_DIR=data
SESSION_TTL_SECONDS=2592000

# ── Conversation ──
MAX_HISTORY_MESSAGES=8
SUMMARY_THRESHOLD=12

# ── Rate Limiting ──
RATE_LIMIT_PER_MIN=20

# ── File Upload ──
MAX_UPLOAD_MB=20

# ── CORS (leave blank if Flask serves the HTML itself) ──
CORS_ORIGINS=

# ── Server ──
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
